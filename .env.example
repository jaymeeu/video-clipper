# Copy this file to .env and fill in real values. .env is gitignored; this file is not,
# so never put a real key here.

# Needed for `clippers detect --ai`. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI model used by --ai (default: gpt-5-mini)
# CLIPPERS_AI_MODEL=gpt-5-mini

# Optional: where transcripts and AI results are cached (default: ~/.cache/clippers)
# CLIPPERS_CACHE_DIR=
