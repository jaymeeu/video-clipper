# Copy this file to .env and fill in real values. .env is gitignored; this file is not,
# so never put a real key here.

# --- AI scoring (optional) -------------------------------------------------------------
# Needed only for `--ai` (CLI) or `"ai": true` (API). Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenAI model used for AI scoring (default: gpt-5-mini)
# CLIPPERS_AI_MODEL=gpt-5-mini

# --- HTTP service ----------------------------------------------------------------------
# Clients must send this as the X-API-Key header. ALWAYS set it on a server; if it's
# empty the API accepts anyone. Generate one with:  openssl rand -hex 32
CLIPPERS_API_KEY=
# Redis used for the job queue (docker compose sets this to redis://redis:6379 itself)
# CLIPPERS_REDIS_URL=redis://localhost:6379
# Where job outputs and downloads are stored (the Docker image uses /data)
# CLIPPERS_DATA_DIR=data
# Days to keep finished jobs, downloads and cached results before cleanup (default: 7)
# CLIPPERS_RETENTION_DAYS=7

# --- Web app (the team UI, `docker compose up` serves it on :8080) --------------------
# Login for the web app. The password is required: the web container won't start
# without it. Avoid "$" in it (docker compose treats "$" as a variable), or wrap the whole
# value in single quotes.
# CLIPPERS_WEB_USER=team
CLIPPERS_WEB_PASSWORD=
# Development only (`npm run dev` in web/): where the Vite proxy sends /api requests.
# CLIPPERS_API_URL=http://127.0.0.1:8000

# --- Caching ---------------------------------------------------------------------------
# Where transcripts and AI answers are cached (default: ~/.cache/clippers)
# CLIPPERS_CACHE_DIR=
