# Serves the built web app and proxies /api/* to the clippers API.
# - Everyone must log in (basic auth): this is an internal tool.
# - The API key is added here, server-side, so it never reaches the browser.
{
	admin off
	auto_https off # TLS is terminated in front of this container (see README)
}

:80 {
	encode zstd gzip

	basic_auth {
		{$CLIPPERS_WEB_USER:team} {$CLIPPERS_WEB_PASSWORD_HASH}
	}

	handle_path /api/* {
		reverse_proxy {$CLIPPERS_API_UPSTREAM:api:8000} {
			header_up X-API-Key "{$CLIPPERS_API_KEY}"
		}
	}

	handle {
		root * /srv
		# Hashed file names never change content: cache them for a year.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
